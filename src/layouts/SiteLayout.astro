---
import "../styles/global.css";
import NesStyles from "../themes/NesStyles.astro";
import RetroStyles from "../themes/RetroStyles.astro";
import PaperStyles from "../themes/PaperStyles.astro";
import { Font } from "astro:assets";
const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="en" data-mode="light">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Apply the saved preference before the first paint and React hydration.
      (() => {
        let mode;
        try {
          mode = localStorage.getItem("portfolio-mode");
        } catch {
          /* Fall back to light mode. */
        }
        document.documentElement.dataset.mode =
          mode === "dark" ? "dark" : "light";
      })();
    </script>
    <Font cssVariable="--font-manrope" />
    <Font cssVariable="--font-cinzel" />
    <Font cssVariable="--font-source-serif" />
    <Font cssVariable="--font-nunito-sans" />
    <Font cssVariable="--font-space-grotesk" />
    <Font cssVariable="--font-dm-sans" />
    <Font cssVariable="--font-neucha" />
    <Font cssVariable="--font-patrick-hand" />
    <Font cssVariable="--font-ms-sans" />
    <PaperStyles />
    <RetroStyles />
    <Font cssVariable="--font-press-start" />
    <NesStyles />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="A small collection of product ideas, useful tools, and creative experiments. Explore different visual interpretations of the same portfolio."
    />
    <link rel="icon" href={`${base}/favicon.svg`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Leon’s workshop — projects"
      href={`${base}/rss.xml`}
    />
    <title>{title} | Leon's workshop</title>
  </head>
  <body>
    <slot />
  </body>
</html>
