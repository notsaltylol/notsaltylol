---
import { site } from "../content/site";
import { themes } from "./themes";
import type { Page } from "./types";
import Tailwind from "../themes/Tailwind.astro";
import Daisy from "../themes/Daisy.astro";
import Hyper from "../themes/Hyper.astro";
import Starwind from "../themes/Starwind.astro";
import Paper from "../themes/Paper.astro";
import Retro from "../themes/Retro.astro";
import Nes from "../themes/Nes.astro";
import ColorModeSwitch from "./ColorModeSwitch.astro";
const { initialPage: page } = Astro.props as { initialPage: Page };
const components = {
  glass: Tailwind,
  gothic: Tailwind,
  minimal: Tailwind,
  daisy: Daisy,
  hyper: Hyper,
  starwind: Starwind,
  paper: Paper,
  retro: Retro,
  nes: Nes,
};
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (page: Page) =>
  `${base}/${page === "projects" ? "projects/" : ""}`;
---

{themes.map(({ id }) => {
  const Presentation = components[id];
  return (
    <div
      class={`website theme-${id}`}
      data-presentation={id}
      data-page={page}
      data-theme={id === "daisy" ? "workshop" : "light"}
    >
      <a href={`#main-${id}`} class="skip-link">
        Skip to content
      </a>
      <header class="site-header">
        <a class="brand" href={href("home")}>
          <span class="brand-mark" aria-hidden="true">
            lk
          </span>
          {site.name}
        </a>
        <nav aria-label="Main navigation">
          {(["home", "projects"] as Page[]).map((item) => (
            <a
              href={href(item)}
              aria-current={page === item ? "page" : undefined}
            >
              {item === "home" ? "Home" : "Projects"}
            </a>
          ))}
        </nav>
        <div class="theme-picker">
          <div class="style-buttons" role="group" aria-label="Visual style">
            {themes.map((theme) => (
              <button data-style={theme.id} aria-pressed={id === theme.id}>
                {theme.label}
              </button>
            ))}
          </div>
          <ColorModeSwitch theme={id} />
        </div>
      </header>
      <main id={`main-${id}`}>
        <Presentation page={page} theme={id} />
      </main>
      <footer>
        <span>{site.note}</span>
        <span>Same ideas. Another perspective.</span>
      </footer>
      <dialog class="project-dialog" aria-labelledby={`project-title-${id}`}>
        <div class="dialog-content">
          <button
            class="dialog-close"
            data-close-dialog
            aria-label="Close project details"
          >
            ×
          </button>
          <span
            class="detail-symbol bg-project-art"
            data-detail-symbol
            aria-hidden="true"
          ></span>
          <p data-detail-meta></p>
          <h2 id={`project-title-${id}`} data-detail-title></h2>
          <p data-detail-text></p>
        </div>
      </dialog>
    </div>
  );
})}
<script>
  import "./controller";
</script>
