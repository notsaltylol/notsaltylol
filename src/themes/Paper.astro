---
import { projects } from "../content/site";
import { site } from "../content/site";
import type { PresentationProps } from "../experience/types";
import Artwork from "./Artwork.astro";

const { page, theme } = Astro.props as PresentationProps;
const home = page === "home";
const p = { page, projects, query: "", category: "All" };
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div class="paper-presentation">
  <header class="paper-heading">
    <span class="badge">Notes from the workbench</span>
    <h1>{home ? site.headline : "The project sketchbook."}</h1>
    <p>
      {home
        ? site.intro
        : "A few ideas worth putting on paper. Find a project and take a closer look."}
    </p>
    {home && (
      <button data-navigate={`${base}/projects/`}>Open the sketchbook</button>
    )}
  </header>
  <section aria-label={home ? "Selected projects" : "All projects"}>
    {home ? (
      <h2 class="paper-section-title">A few pages to start with</h2>
    ) : (
      <div class="gallery-controls">
        <input
          aria-label="Search projects"
          placeholder="Search the sketchbook…"
          value={p.query}
          data-search
        />
        <div class="filter-group" aria-label="Filter projects">
          {["All", "Product", "Tool", "Experiment"].map((category) => (
            <button
              class={p.category === category ? "btn-primary" : "btn-small"}
              aria-pressed={p.category === category}
              data-category={category}
            >
              {category}
            </button>
          ))}
        </div>
      </div>
    )}
    <div class="paper-grid">
      {(home ? p.projects.slice(0, 3) : p.projects).map((project) => (
        <article
          class="card border"
          id={theme === "glass" ? project.id : `${theme}-${project.id}`}
          data-project-card={project.id}
        >
          <Artwork project={project} />
          <div class="card-body">
            <div class="card-meta">
              <span class="badge">{project.category}</span>
              <span>{project.year}</span>
            </div>
            <h2 class="card-title">{project.name}</h2>
            <p class="card-text">{project.description}</p>
            <button data-open-project={project.id}>
              Explore {project.name}
            </button>
          </div>
        </article>
      ))}
    </div>
    {!home && (
      <p class="empty-state" data-empty hidden>
        No projects match. Try another search or category.
      </p>
    )}
  </section>
</div>
