---
// Liquid-glass technique inspired by daftplug:
// https://codepen.io/daftplug/pen/QwbaYGO
// Keep the filter in the rendered document: display:none breaks SVG references
// in some engines. Only the backdrop layer uses it; text stays undistorted.
---

<svg class="glass-filter-definitions" aria-hidden="true" width="0" height="0">
  <defs>
    <filter
      id="portfolio-liquid-glass"
      x="-20%"
      y="-20%"
      width="140%"
      height="140%"
      color-interpolation-filters="sRGB"
    >
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.008 0.008"
        numOctaves="2"
        seed="92"
        result="noise"
      />
      <feGaussianBlur in="noise" stdDeviation="0.5" result="refraction" />
      <feDisplacementMap
        in="SourceGraphic"
        in2="refraction"
        scale="32"
        xChannelSelector="R"
        yChannelSelector="G"
      />
    </filter>
  </defs>
</svg>

<style>
  .glass-filter-definitions {
    position: absolute;
    pointer-events: none;
  }
</style>
