---
import { projects } from "../content/site";
import { site } from "../content/site";
import type { PresentationProps } from "../experience/types";
import Artwork from "./Artwork.astro";
// Card structure adapted from HyperUI's bordered/offset marketing cards.

const { page, theme } = Astro.props as PresentationProps;
const home = page === "home";
const p = { page, projects, query: "", category: "All" };
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div class="hyper-presentation">
  <header class="hyper-heading">
    <div>
      <p class="hyper-intro">Independent ideas, out in the world.</p>
      <h1>{home ? site.headline : "Projects in the wild."}</h1>
    </div>
    <div class="hyper-side">
      <span class="big-asterisk" aria-hidden="true">
        ✳
      </span>
      <p>
        {home
          ? site.intro
          : "Tools, products, and experiments. Different questions, different ways of making."}
      </p>
      {home && (
        <button class="hyper-button" data-navigate={`${base}/projects/`}>
          See the collection <span aria-hidden="true">↗</span>
        </button>
      )}
    </div>
  </header>
  <section aria-label={home ? "Selected projects" : "All projects"}>
    {home ? (
      <div class="section-heading">
        <h2>Things I've been making</h2>
        <span>Selected work / 2025–26</span>
      </div>
    ) : (
      <div class="gallery-controls">
        <label class="hyper-search">
          <span class="sr-only">Search projects</span>
          <input placeholder="Find a project…" value={p.query} data-search />
          <span aria-hidden="true">⌕</span>
        </label>
        <div class="filter-group" aria-label="Filter projects">
          {["All", "Product", "Tool", "Experiment"].map((c) => (
            <button
              class={`hyper-filter ${p.category === c ? "active" : ""}`}
              aria-pressed={p.category === c}
              data-category={c}
            >
              {c}
            </button>
          ))}
        </div>
      </div>
    )}
    <div class="hyper-grid">
      {(home ? p.projects.slice(0, 3) : p.projects).map((project) => (
        <button
          id={theme === "glass" ? project.id : `${theme}-${project.id}`}
          data-project-card={project.id}
          class="group hyper-card relative block text-left"
          data-open-project={project.id}
        >
          <span
            class="absolute inset-0 border-2 border-line"
            aria-hidden="true"
          />
          <div class="hyper-card-inner relative h-full border-2 border-line bg-surface-solid transition-transform group-hover:-translate-x-1 group-hover:-translate-y-1">
            <Artwork project={project} />
            <div class="hyper-card-copy">
              <div class="card-meta">
                <span>{project.category}</span>
                <span>{project.year}</span>
              </div>
              <h2>
                {project.name}
                <span aria-hidden="true">↗</span>
              </h2>
              <p>{project.description}</p>
            </div>
          </div>
        </button>
      ))}
    </div>
    {!home && (
      <p class="empty-state" data-empty hidden>
        Nothing here yet. Try another search or category.
      </p>
    )}
  </section>
</div>
