---
import { themes } from "./themes";
import ColorModeSwitch from "./ColorModeSwitch.astro";
import type { ThemeId } from "./types";
const { theme } = Astro.props as { theme?: ThemeId };
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<details class="site-settings">
  <summary aria-label="Appearance settings" title="Appearance settings">
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <path d="m9 3-.6 2.2-2 .9-2-.6-2 3.5 1.5 1.7v2.6L2.4 15l2 3.5 2-.6 2 .9L9 21h4l.6-2.2 2-.9 2 .6 2-3.5-1.5-1.7v-2.6L19.6 9l-2-3.5-2 .6-2-.9L13 3Z" />
      <circle cx="11" cy="12" r="3" />
    </svg>
  </summary>
  <div class="settings-panel">
    <p>Appearance</p>
    <a href={`${base}/`} aria-current={!theme ? "page" : undefined}>
      Résumé
    </a>
    <a href={`${base}/random/`} data-astro-reload>
      Random theme
    </a>
    <div class="settings-themes" role="group" aria-label="Visual style">
      {themes.map(({ id, label }) =>
        theme ? (
          <button data-style={id} aria-pressed={id === theme}>
            {label}
          </button>
        ) : (
          <a href={`${base}/random/?theme=${id}`} data-astro-reload>
            {label}
          </a>
        ),
      )}
    </div>
    <ColorModeSwitch theme={theme ?? "minimal"} />
  </div>
</details>
